# Explicit public source categories; local artifacts are ignored by default.
/*
!/README.md
!/CONTRIBUTING.md
!/src/
!/bin/
!/docs/
!/repository-layout.json
!/.gitignore
!/requirements-qa.txt
!/examples/
!/tests/
!/web/
!/scripts/
!/reports/
!/evidence/
# Private service state, credentials, conversations and local tool installations.
/runtime/
/tools/
/AGENTS.md
/.agents/
/.opencode/
/.qa-*/
/.browsers/
/.cache/
/.pytest_cache/
/.venv/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
*.key
*.pem
*.sqlite*
*.db
*.ext4
*.whl
*.tar.gz
*.log
# Raw installation evidence contains local topology; publish curated reports.
/evidence/*
!/evidence/README.md
/_docker_cli_empty/
/reports/*
!/reports/v036-public.json
!/reports/publication-manifest.json
!/reports/public-source-check.json
!/reports/mixed-compiler-stage.json
!/reports/repository-layout-check.json
!/reports/retention-policy-check.json

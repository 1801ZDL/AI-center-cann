#!/usr/bin/env python3
"""Explicit, bounded operations. Installing this file never enables a timer."""
import argparse
import json
import os
from pathlib import Path
import resource
import signal
import sqlite3
import stat
import sys

sys.dont_write_bytecode = True


def private_json(path, maximum=262144):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077 or info.st_nlink != 1 or info.st_size > maximum:
            raise ValueError('Operation input must be a private, bounded owned regular file')
        return json.loads(stream.read(maximum + 1))


def limit():
    os.umask(0o077)
    os.sched_setaffinity(0, {min(os.sched_getaffinity(0))})
    resource.setrlimit(resource.RLIMIT_AS, (256 * 1024**2, 256 * 1024**2))
    resource.setrlimit(resource.RLIMIT_CPU, (2, 2))
    signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError('Operation exceeded its observation budget; retain original journal')))
    signal.alarm(5)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest='action', required=True)
    p = subs.add_parser('pressure', help='One proc/cgroup snapshot; no device commands')
    p = subs.add_parser('maintenance', help='Preview or resume one exact offline maintenance approval')
    p.add_argument('--plan', required=True)
    p.add_argument('--apply', action='store_true')
    p = subs.add_parser('maintenance-select', help='Select one bounded offline retention approval; never apply it')
    p.add_argument('--prefix',required=True);p.add_argument('--policy',required=True)
    p.add_argument('--after-rowid',type=int,default=0)
    p.add_argument('--execution-contract',help='Bind an explicit finite v2 execution approval')
    p = subs.add_parser('maintenance-window',help='Bind a finite execution window and invocation budget; no execution')
    p.add_argument('--plan',required=True);p.add_argument('--contract',required=True)
    p = subs.add_parser('maintenance-status',help='Read original journal progress without advancing it')
    p.add_argument('--plan',required=True)
    p=subs.add_parser('maintenance-revoke',help='Permanently stop future steps of one original maintenance plan')
    p.add_argument('--plan',required=True);p.add_argument('--apply',action='store_true')
    p.add_argument('--reason',choices=['operator_stop','resource_pressure','superseded_after_review','maintenance_incident'],default='operator_stop')
    p=subs.add_parser('maintenance-plan-backup',help='Preserve one original approval and its private journal/anchor/revocation')
    p.add_argument('--plan',required=True);p.add_argument('--output',required=True);p.add_argument('--prefix');p.add_argument('--apply',action='store_true')
    p=subs.add_parser('maintenance-plan-recover',help='Recover one private approval as permanently stopped evidence; never run it')
    p.add_argument('--prefix',required=True);p.add_argument('--archive',required=True);p.add_argument('--apply',action='store_true')
    p = subs.add_parser('result-history-plan',help='Preview result-body rotation against an original migrated job copy')
    p.add_argument('--prefix',required=True);p.add_argument('--export-id',required=True)
    p = subs.add_parser('result-history-apply',help='Apply one exact offline result-body migration approval')
    p.add_argument('--plan',required=True)
    p = subs.add_parser('grant-history-plan',help='Preview inactive source-grant body rotation only')
    p.add_argument('--prefix',required=True);p.add_argument('--export-id',required=True)
    p = subs.add_parser('grant-history-apply',help='Apply one exact inactive grant history approval')
    p.add_argument('--plan',required=True)
    p = subs.add_parser('notify-once', help='Optional one-event delivery; never called by the scheduler')
    p.add_argument('--prefix', required=True)
    p.add_argument('--destinations', required=True)
    p.add_argument('--send', action='store_true', help='Explicitly permit one HTTPS delivery')
    p.add_argument('--after-node',default='',help='Bounded health scan cursor for deployments with more than32 Nodes')
    p = subs.add_parser('notification-archive',help='Seal at most32 delivered or explicitly closed events with their decisions')
    p.add_argument('--prefix',required=True);p.add_argument('--directory',required=True)
    p.add_argument('--apply',action='store_true')
    p=subs.add_parser('notification-list',help='Inspect at most32 retained events; no delivery')
    p.add_argument('--prefix',required=True);p.add_argument('--destinations')
    p.add_argument('--after-id',default='');p.add_argument('--limit',type=int,default=16)
    p=subs.add_parser('notification-plan',help='Plan one exact hold/retry/rebind/close decision; no delivery')
    p.add_argument('--prefix',required=True);p.add_argument('--event-id',required=True)
    p.add_argument('--decision',choices=['hold','retry','rebind','close'],required=True)
    p.add_argument('--reason',choices=['operator_review','transient_failure','destination_update','no_longer_needed','receiver_checked'],default='operator_review')
    p.add_argument('--destinations');p.add_argument('--extra-attempts',type=int,default=0)
    p.add_argument('--accept-uncertain-delivery',action='store_true')
    p=subs.add_parser('notification-apply',help='Apply an original private decision once; never send')
    p.add_argument('--prefix',required=True);p.add_argument('--plan',required=True);p.add_argument('--destinations')
    args = parser.parse_args()
    limit()
    if args.action == 'pressure':
        from resource_pressure import sample,sample_execution
        return {**sample(),'execution_pressure':sample_execution()}
    if args.action=='maintenance-window':
        from maintenance_runner import with_execution
        return with_execution(private_json(args.plan),private_json(args.contract))
    if args.action in {'maintenance-plan-backup','maintenance-plan-recover'}:
        from maintenance_plan_backup import export,recover
        if args.action=='maintenance-plan-backup':return export(private_json(args.plan),args.output,apply=args.apply,prefix=args.prefix)
        return recover(args.prefix,args.archive,apply=args.apply)
    if args.action in {'notification-list','notification-plan','notification-apply'}:
        from notification_ops import inspect,plan,apply,check
        destinations=private_json(args.destinations,65536) if args.destinations else None
        if args.action=='notification-list':return inspect(args.prefix,destinations=destinations,after_id=args.after_id,limit=args.limit)
        if args.action=='notification-plan':
            return plan(args.prefix,args.event_id,args.decision,reason=args.reason,destinations=destinations,
                        extra_attempts=args.extra_attempts,accept_uncertain=args.accept_uncertain_delivery)
        return apply(args.prefix,check(private_json(args.plan,8192)),destinations=destinations)
    if args.action in {'result-history-plan','result-history-apply'}:
        from result_history import plan,apply
        if args.action=='result-history-plan':return plan(args.prefix,args.export_id)
        value=private_json(args.plan)
        from result_history import check
        check(value)
        return apply(value['binding']['prefix'],value)
    if args.action in {'grant-history-plan','grant-history-apply'}:
        from grant_history import plan,apply,check
        if args.action=='grant-history-plan':return plan(args.prefix,args.export_id)
        value=check(private_json(args.plan))
        return apply(value['binding']['prefix'],value)
    if args.action == 'maintenance-select':
        from deployment import require_root,verify
        require_root()
        prefix,meta,release=verify(args.prefix)
        if meta['role']!='controller' or (release/'maintenance_policy.py').read_bytes()!=Path(__file__).with_name('maintenance_policy.py').read_bytes():
            raise ValueError('Use matching installed retention selection code')
        from maintenance_policy import plan
        execution=private_json(args.execution_contract) if args.execution_contract else None
        return plan(prefix,private_json(args.policy),after_rowid=args.after_rowid,execution=execution)
    if args.action in {'maintenance','maintenance-status','maintenance-revoke'}:
        from maintenance_runner import run_once,checked
        value = checked(private_json(args.plan))
        if args.action=='maintenance' and not args.apply:
            return run_once(value, '/unused', apply=False)
        if args.action=='maintenance-revoke' and not args.apply:
            from maintenance_lifecycle import revoke_once
            return revoke_once(value,'/unused',reason=args.reason,apply=False)
        from deployment import require_root, verify
        require_root()
        prefix, meta, release = verify(value['prefix'])
        if meta['role'] != 'controller' or (release / 'maintenance_runner.py').read_bytes() != Path(__file__).with_name('maintenance_runner.py').read_bytes():
            raise ValueError('Use the matching installed controller maintenance code')
        if (release/'maintenance_lifecycle.py').read_bytes()!=Path(__file__).with_name('maintenance_lifecycle.py').read_bytes():
            raise ValueError('Use matching installed maintenance lifecycle code')
        journal_dir = prefix / 'maintenance-runs'
        if args.action=='maintenance-status':
            from maintenance_runner import status
            return status(value,journal_dir/(value['id']+'.json'))
        journal_dir.mkdir(mode=0o700, exist_ok=True)
        if args.action=='maintenance-revoke':
            from maintenance_lifecycle import revoke_once
            return revoke_once(value,journal_dir/(value['id']+'.json'),reason=args.reason,apply=True)
        return run_once(value, journal_dir / (value['id'] + '.json'), apply=True)
    from deployment import require_root, verify
    require_root()
    prefix, meta, release = verify(args.prefix)
    if meta['role'] != 'controller' or (release / 'notifications.py').read_bytes() != Path(__file__).with_name('notifications.py').read_bytes():
        raise ValueError('Use the matching installed controller notification code')
    destinations = private_json(args.destinations, 65536) if args.action=='notify-once' else None
    from audit_retention import service_identity
    from state_lock import state_lock
    with service_identity(meta),state_lock(meta['state_dir']):
        config = private_json(Path(meta['state_dir']) / 'config.json')
        from notifications import policy, dispatch_one, initialize, health_once, outbox_status
        if args.action=='notification-archive':
            from notifications import archive_delivered
            with sqlite3.connect(Path(meta['state_dir'])/'jobs.sqlite3',timeout=.2) as connection:
                return archive_delivered(connection,args.directory,apply=args.apply)
        settings = policy(config.get('scheduler', {}).get('notifications'))
        if not settings['enabled']:
            return {'status': 'disabled', 'sent': False}
        if not args.send:
            return {'status': 'preview', 'sent': False, 'configured_owners': len(destinations)}
        from control_monitor import inspect
        status = inspect(prefix)
        storage = 'unknown' if not status.get('check_success') else status.get('status', 'unknown')
        with sqlite3.connect(Path(meta['state_dir']) / 'jobs.sqlite3', timeout=.2) as db:
            initialize(db)
            cursor=health_once(db, config['username'], settings, config.get('scheduler', {}).get('resource_pressure'), storage=storage,after_node=args.after_node)
        connection = sqlite3.connect(Path(meta['state_dir']) / 'jobs.sqlite3', timeout=.2)
        try:return {**dispatch_one(connection, destinations),'health_next_after':cursor,'outbox':outbox_status(connection)}
        finally:connection.close()


if __name__ == '__main__':
    try:
        print(json.dumps(main(), ensure_ascii=False, allow_nan=False))
    except (ValueError, OSError, RuntimeError, TimeoutError, sqlite3.Error) as error:
        # No webhook URL, configuration secret or remote response is printed.
        print(json.dumps({'status': 'not_completed', 'error_type': type(error).__name__,
                          'retain_original_request': True}))
        raise SystemExit(1)

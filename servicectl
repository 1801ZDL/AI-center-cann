        _,meta,_=deploy.verify(args.prefix);result={k:meta[k] for k in ['role','uid','gid','state_dir','release_id','state_schema']};result['verified']=True
    elif args.action=='backup':result=snapshot(args.prefix,args.output)
    elif args.action=='restore':result=restore(args.prefix,args.archive,args.new_state_dir,payload_config=args.payload_config,spool_config=args.spool_config,cache_config=args.cache_config,control_config=args.control_config)
    elif args.action=='activate':result=activate(args.prefix,args.archive,args.release_id)
    elif args.action=='admin':
        prefix,meta,release=deploy.verify(args.prefix,owner_recovery=True,delivery_recovery=True,finish_recovery=True)
        if meta['role']!='controller':raise deploy.DeployError('Account/node enrollment is administered on the controller installation')
        if os.geteuid() not in {0,meta['uid']}:raise deploy.DeployError('Service identity or root is required')
        command=args.command[1:] if args.command[:1]==['--'] else args.command
        state_flags={'--state-dir','--controller-state'}
        overrides=any(x.startswith('--') and len(x.split('=',1)[0])>2 and any(flag.startswith(x.split('=',1)[0]) for flag in state_flags) for x in command[1:])
        if not command or command[0] not in {'accessctl','workerctl'} or overrides:raise deploy.DeployError('Choose accessctl or workerctl without overriding this installation state')
        def drop():
            if os.geteuid()==0:
                from payload_groups import gids
                os.setgroups(gids(meta.get('payload_storage')))
                os.setgid(meta['gid']);os.setuid(meta['uid'])
        flag='--state-dir' if command[0]=='accessctl' else '--controller-state'
        code='import runpy,sys;sys.path.insert(0,sys.argv[1]);sys.argv=sys.argv[2:];runpy.run_path(sys.argv[0],run_name="__main__")'
        completed=subprocess.run(['/usr/bin/python3','-I','-B','-c',code,str(release),str(release/command[0]),flag,meta['state_dir'],*command[1:]],
                    preexec_fn=drop,env={'PATH':'/usr/local/bin:/usr/bin:/bin','HOME':meta['state_dir'],'LANG':'C.UTF-8'},check=False)
        raise SystemExit(completed.returncode)
    else:
        deploy.require_root();prefix,meta,_=deploy.verify(args.prefix)
        target=deploy.secure_parent(Path(args.unit_dir)/('ascend-lab-'+meta['role']+'.service'))
        if target.exists() or target.is_symlink():raise deploy.DeployError('Unit already exists; existing services were not overwritten')
        with target.open('x') as file:file.write(deploy.unit_text(prefix,meta))
        target.chmod(0o644)
        if args.enable:
            subprocess.run(['systemctl','daemon-reload'],check=True)
            subprocess.run(['systemctl','enable','--now',target.name],check=True)
        result={'unit':str(target),'enabled':args.enable}
    print(json.dumps(result,ensure_ascii=False,indent=2))


if __name__=='__main__':

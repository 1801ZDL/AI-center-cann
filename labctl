from lab_client import Client, ClientError, job_id, private_profile

ROOT = Path(__file__).resolve().parent
RUN = ROOT / 'runtime'


def settings(port):
    RUN.mkdir(mode=0o700, exist_ok=True)
    config = RUN / 'config.json'
    if not config.exists():
        config.write_text(json.dumps({'username': pwd.getpwuid(os.getuid()).pw_name,
                                      'container': 'zdl', 'host': '127.0.0.1', 'port': port,
                                      'interval': 15, 'password': secrets.token_urlsafe(24)}, indent=2) + '\n')
        config.chmod(0o600)
    return json.loads(config.read_text())


def alive():
    try:
        pid = int((RUN / 'server.pid').read_text())
        # Guard against stale/reused PID files before sending any signal.
        argv = Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
        if str(ROOT / 'server.py').encode() not in argv:
            return None
        if Path(f'/proc/{pid}').stat().st_uid != os.getuid():
            return None
        return pid
    except (OSError, ValueError):
        return None


def request(config, path, body=None):
    try:
        return Client(config).request(path, body)
    except ClientError as error:
        raise SystemExit(str(error)) from None


def wait_job(config, job_id, seconds, archive_options=None):
    deadline = time.monotonic() + seconds
    previous = None
    while time.monotonic() < deadline:
        job = request(config, '/api/jobs/' + job_id)['job']
        if job['state'] != previous:
            print(job_id, job['state'], job['reason'], flush=True)
            previous = job['state']
        if job['state'] in {'succeeded', 'failed', 'cancelled', 'timed_out'}:
            print(json.dumps(job.get('result'), ensure_ascii=False, indent=2))
            if archive_options is not None:
                from client_archive import download
                print(json.dumps({'local_archive':download(Client(config),job_id,**archive_options)},ensure_ascii=False,indent=2))
            return 0 if job['state'] == 'succeeded' else 1
        if job['state']=='needs_attention':
            print('Execution state is unconfirmed; resources remain reserved. No final archive or replacement task was created.')
            return 3
        time.sleep(1)
    print('Client wait ended; the job remains managed by the scheduler.')
    return 2


def main():

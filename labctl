    listing=storage.add_parser('list');listing.add_argument('--state');listing.add_argument('--limit',type=int,default=100);listing.add_argument('--offset',type=int,default=0)
    plan=storage.add_parser('plan');plan.add_argument('kind',choices=['input','archive']);plan.add_argument('object_id');plan.add_argument('operation',choices=['trash','restore','purge','resume'])
    apply=storage.add_parser('apply');apply.add_argument('--plan',required=True);apply.add_argument('--wait-seconds',type=int,default=30)
    for action in ['job', 'logs', 'cancel', 'wait','retry-inputs']:
        command = sub.add_parser(action)
        command.add_argument('job_id')
        if action == 'logs':
            command.add_argument('--stream', choices=['stdout', 'stderr'], default='stdout')
        if action == 'wait':
            command.add_argument('--seconds', type=int, default=120)
            command.add_argument('--archive', action='store_true');command.add_argument('--archive-root');command.add_argument('--local-source')
    args = p.parse_args()
    if (ROOT/'client-only').exists() and not args.profile:
        p.error('This portable client requires a personal --profile and cannot manage the controller')
    if args.profile:
        if args.action not in {'submit','jobs','job','logs','cancel','wait','me','nodes','input-add','input','environment-lock','archive','archive-config','diagnose','operator-case','storage','retry-inputs'}:
            p.error('Client profiles only support job operations')
        config = private_profile(args.profile)
    else:
        config = settings(getattr(args, 'port', 18765))
    url = Client(config).url
    pid = alive() if args.action in {'start','stop','status'} else None
    if hasattr(args,'job_id'):
        args.job_id = job_id(args.job_id)
    if args.action == 'start':
        if pid:
            print(f'Already running: {url} (PID {pid})')
            return
        with socket.socket() as probe:
            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                probe.bind(('127.0.0.1', config['port']))
            except OSError:
                sys.exit(f"Port {config['port']} is occupied; no existing service was changed.")
        with (RUN / 'bootstrap.log').open('a') as out:
            child = subprocess.Popen(['/usr/bin/python3', '-u', str(ROOT / 'server.py')],
                                     cwd=ROOT, stdin=subprocess.DEVNULL, stdout=out, stderr=out,
                                     start_new_session=True)
        for _ in range(50):
            if child.poll() is not None:
                sys.exit('Startup failed. See runtime/bootstrap.log.')
            try:
                with urllib.request.urlopen(url + '/healthz', timeout=1) as response:
                    if response.status == 200:
                        print(f'Running: {url}\nPrivate credentials: {RUN / "config.json"}\nUse ./labctl access to display login details.')
                        return
            except OSError:
                time.sleep(0.1)
        sys.exit('Server startup is taking longer than expected; check ./labctl status.')
    elif args.action == 'stop':
        if not pid:
            print('This demo is not running.')
            return
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if not alive():
                print('Dashboard/scheduler stopped. Managed job workers continue independently; other processes and containers were not changed.')
                return
            time.sleep(0.1)
        sys.exit('Stop requested; process has not exited yet.')
    elif args.action == 'status':
        print(f'Running: {url} (PID {pid})' if pid else 'Stopped')
    elif args.action == 'access':
        print(f"Demo web login — independent of your Linux/SSH password.\nURL: {url}\nUsername: {config['username']}\nPassword: {config['password']}\n\nEnter the Password above in the browser, not your SSH password.\nFor remote access, forward port {config['port']} through your existing SSH connection.")
    elif args.action == 'export':
        target = RUN / ('export-' + time.strftime('%Y%m%d-%H%M%S') + '.json')
        target.write_text(json.dumps(request(config, '/api/export'), ensure_ascii=False, indent=2)+'\n')
        print(target)
    elif args.action == 'submit':
        if args.archive and not 1<=args.wait_seconds<=86400:p.error('wait-seconds must be between 1 and 86400')
        if args.archive_root and not args.archive:p.error('archive-root requires --archive; use archive-config for a permanent preference')
        if args.local_source:
            from client_archive import directory, local_path
            selected=local_path(args.local_source)
            with directory(selected if selected.is_dir() else selected.parent):pass
        selected_env=args.env
        args.env = args.env or (config.get('default_environment','worker-python') if args.profile else 'host-python')
        argv = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
        body = {'name': args.name or (Path(argv[0]).name if argv else 'job'), 'environment': args.env,
                'kind': args.kind, 'cwd': str(Path(args.cwd).resolve()), 'cpu': args.cpu,
                'memory_mib': args.memory_mib, 'npu': args.npu, 'timeout_seconds': args.timeout, 'argv': argv}
        body['shm_mib'] = args.shm_mib
        if args.template:
            if argv:
                p.error('Templates cannot accept command overrides')
            body = {'template':args.template,'parameters':{'seconds':args.seconds} if args.template=='cpu_demo' else {},'environment':args.env,
                    **({'name':args.name} if args.name else {})}
            # Profile defaults must come from the authenticated server workspace.
            if not args.profile:
                body['cwd'] = str(Path(args.cwd).resolve())
        if args.workflow:
            if args.template or argv:p.error('Workflow cannot be combined with template/command overrides')
            try:body=json.loads(Path(args.workflow).read_text())
            except (OSError,ValueError):p.error('Cannot read workflow JSON')
            if not isinstance(body,dict) or body.get('template') not in {'accuracy_v1','performance_v1','simulation_v1','build_v1','ir_v1'}:p.error('Choose a versioned workflow template')
            if selected_env:body['environment']=selected_env
            body.setdefault('environment','worker-python')
            if args.name:body['name']=args.name
        if (args.artifact_file_mib is None)!=(args.artifact_total_mib is None):
            p.error('artifact-file-mib and artifact-total-mib must be supplied together')
        if args.artifact_file_mib is not None:
            if args.template or args.workflow:p.error('Artifact flags are for legacy commands; set parameters.artifacts in workflow JSON')
            from io_policy import artifacts
            try:body['parameters']={'artifacts':artifacts({'file_mib':args.artifact_file_mib,'total_mib':args.artifact_total_mib})}
            except ValueError as error:p.error(str(error))
        if args.project:
            body['project'] = args.project
        if args.key:
            body['idempotency_key'] = args.key
        if args.output:
            body['output'] = args.output
        if args.preview:
            if args.archive or args.archive_root or args.local_source:
                p.error('Preview does not submit or archive; omit archive/local-source flags')
            print(json.dumps(request(config,'/api/jobs/preview',body),ensure_ascii=False,indent=2))
            return 0
        response=request(config, '/api/jobs', body)
        print(json.dumps(response, ensure_ascii=False, indent=2),flush=True)
        if args.profile:
            from client_archive import remember_submission
            try:remember_submission(args.profile,Client(config),response['job'],source=args.local_source,
                                    input_id=body.get('parameters',{}).get('input_id'),fallback=Path.cwd())
            except (ClientError,OSError):raise ClientError('Job '+response['job']['id']+' is already submitted; local archive context could not be saved. Use archive with --local-source; do not resubmit.') from None
        if args.archive:
            return wait_job(config,response['job']['id'],args.wait_seconds,
                            {'profile':args.profile,'root':args.archive_root,'source':args.local_source})
